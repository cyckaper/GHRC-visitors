# ── 必要 ─────────────────────────────────────────────
ANTHROPIC_API_KEY=            # Claude API（讀信、排程、抽取、草擬、簽名簿 OCR、摘要）
ADMIN_TOKEN=                  # 主辦端 admin.html 登入用的長隨機字串
SIGNAL_KEY=                   # NFC 捷徑／簡報捷徑送訊號時的共用金鑰

# ── 選用 ─────────────────────────────────────────────
OPENAI_API_KEY=               # Whisper：主持人三十秒口述轉文字（未設則口述只存音檔）
CLAUDE_MODEL=claude-opus-5    # 預設模型
WHISPER_MODEL=whisper-1
SITE_URL=https://visit.healsdesign.org

# 資料層：file（本機）| blobs（Netlify 預設）| sheets（Google Sheet）
STORE_BACKEND=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=  # 服務帳戶 JSON 全文（單行）；Sheet 需分享給該帳戶

# 訪後信寄送（Gmail API，OAuth2 refresh token；未設則後台提供複製／mailto）
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=ntughrc@gmail.com

# 本機開發／測試
AI_MOCK=                      # 設為 1 時所有 AI 呼叫回傳固定範例，不需金鑰
